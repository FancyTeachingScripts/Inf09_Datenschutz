{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compile-single-tex",
            "type": "shell",
            "command": "/bin/bash",
            "args": [
                "-c",
                "mkdir -p build && lualatex -interaction=nonstopmode -output-directory=build main.tex"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": [
                "$latex"
            ]
        },
        {
            "label": "build-all-main-tex",
            "type": "shell",
            "command": "/bin/bash",
            "args": [
                ".vscode/build-parallel.sh"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
