{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compile-single-tex",
            "type": "shell",
            "command": "/bin/bash",
            "args": [
                "-c",
                "mkdir -p build && tectonic -o build -Z search-path=. -Z search-path=sty main.tex"
            ],
            "windows": {
                "command": "powershell",
                "args": [
                    "-Command",
                    "if (!(Test-Path build)) { New-Item -ItemType Directory -Path build | Out-Null }; tectonic -o build -Z search-path=. -Z search-path=sty main.tex"
                ]
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": [
                "$latex"
            ]
        },
        {
            "label": "build-all-main-tex",
            "type": "shell",
            "command": "/bin/bash",
            "args": [
                ".vscode/build-parallel.sh"
            ],
            "windows": {
                "command": "powershell",
                "args": [
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    ".vscode/build-parallel.ps1"
                ]
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
